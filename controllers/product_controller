const Joi = require("joi");

const ProductModel = require("../models/product_model.js");

const postProduct = async (req, res, next) => {
    const productCreate = Joi.object({
        heading: Joi.string().min(5).required(),
        details: Joi.string().min(20).required(),
        producer: Joi.string().default("Reader")
    });
    const { error, value } = productCreate.validate(req.body);

    if (error) {
        return res.status(400).json(" Details and heading are required respectively");
    }

    try {
        const { heading, details, producer } = value;
        const newProduct = new ProductModel({
            heading,
            details,
            producer
        });
        await newArticle.save();
        res.status(200).json({ message: "Article created successfully", data: newArticle });
    } catch (error) {
        next(error);
    }
};



const getAllProducts = async (req, res, next) => {
    const limit = parseInt(req.query.limit) || 10;
    const skip = parseInt(req.query.skip) || 0;
    try {
        const productGet = await ProductModel.find().sort({ createdAt: -1 }).limit(limit).skip(skip);
        res.status(200).json({ message: "Products retrieved successfully", data: productGet });
    } catch (error) {
        next(error);
    }
};



const getProductById = async (req, res, next) => {
    try {
        const product = await ProductModel.findById(req.params.id);
        if (!product) {
            return res.status(404).json({ message: `Product with ${req.params.id} not found ` });
        }
        res.status(200).json({ message: "Product retrieved successfully", data: product });
    } catch (error) {
        next(error);
    }
};



const updateProduct = async (req, res, next) => {
    const productUpdate = Joi.object({
        title: Joi.string().min(5).optional(),
        content: Joi.string().min(20).optional(),
        author: Joi.string().optional()
    });
    const { error, value } = productUpdate.validate(value);
    if (error) {
        return res.status(400).json("Content and title are required respectively");
    }

    try {
        const updatedProduct = await ProductModel.findByIdAndUpdate(req.params.id, { ...req.body }, {
            new: true, runValidators: true,
        })
        if (!updatedProduct) {
            return res.status(404).json({
                message: "product not updated"
            })
        } res.status(200).json({ updatedProduct })
    } catch (error) {
        next(error);
    }
};



const deleteProductById = async (req, res, next) => {
    try {
        const product = await ProductModel.findByIdAndDelete(req.params.id);
        if (!product) {
            return res.status(404).json({ message: `Product not found` })
        }
        res.status(200).json({ message: `Product deleted` })
    } catch (error) {
        next(error)
    }
};

module.exports = {
    postProduct,
    getAllProducts,
    getProductById,
    updateProduct,
    deleteProductById
}